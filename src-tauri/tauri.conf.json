{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursor Usage Widget",
  "version": "0.1.0",
  "identifier": "com.cykim.cursor-usage-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cursor Usage",
        "width": 340,
        "height": 164,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "Cursor Usage — 설정",
        "url": "settings.html",
        "width": 420,
        "height": 560,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
